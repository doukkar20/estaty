# InfinityFree fixes the document root at htdocs. Expose public/ only.
RewriteEngine On
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(?:app|bootstrap|config|database|deploy|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]
RewriteRule ^(?:artisan|server\.php|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|webpack\.mix\.js)$ - [F,L,NC]
RewriteRule ^public/installer(?:/|$) - [F,L,NC]
RewriteRule ^public/ - [L]
RewriteRule ^(.*)$ public/$1 [L]

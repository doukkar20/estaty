APP_NAME=RAFAIMMOBILIER
APP_ENV=production
APP_TIMEZONE=Africa/Casablanca
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
MAIL_MAILER=log
PERSISTENT_PATH=/data
# Explicit opt-in, used only with an empty database. Never resets existing tables.
SITE_INITIALIZE=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
